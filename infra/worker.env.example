CONTROL_PLANE_URL=http://172.17.0.1:8021
# New Bot VPS uses a per-node credential file. WORKER_SHARED_SECRET is legacy-only.
WORKER_CREDENTIAL_FILE=/opt/meta-ads-copilot-runtime/worker-data/worker.credential
WORKER_KEY=ads-vps-82
WORKER_NAME=Ads Browser VPS 82
WORKER_DATA_DIR=/opt/meta-ads-copilot-runtime/worker-data
WORKER_RUNTIME_VERSION=0.2.0
HERMES_AGENT_VERSION=managed
HERMES_HOME=/opt/meta-ads-copilot-runtime/worker-data/hermes
WORKER_POLL_SECONDS=3
WORKER_HEARTBEAT_SECONDS=15
BROWSER_SESSION_ENABLED=true
BROWSER_SESSION_PUBLIC_BASE_URL=https://ads.lushmedia.net
BROWSER_SESSION_START_URL=https://business.facebook.com/adsmanager/manage/campaigns
BROWSER_SESSION_BIND_HOST=127.0.0.1
BROWSER_SESSION_CHROMIUM_BIN=/snap/chromium/current/usr/lib/chromium-browser/chrome
# Fallback unwrap path nếu distro vẫn cấu hình /snap/bin/chromium.
BROWSER_SESSION_SNAP_DIRECT_BIN=/snap/chromium/current/usr/lib/chromium-browser/chrome
BROWSER_SESSION_NOVNC_WEB_DIR=/usr/share/novnc
BROWSER_SESSION_PROFILE_ROOT=/opt/meta-ads-copilot-runtime/worker-data/browser-profiles
BROWSER_SESSION_STATE_ROOT=/opt/meta-ads-copilot-runtime/worker-data/browser-sessions
BROWSER_SESSION_DISPLAY_BASE=190
BROWSER_SESSION_VNC_PORT_BASE=15900
BROWSER_SESSION_WEB_PORT_BASE=16080
BROWSER_SESSION_DEBUG_PORT_BASE=19220
BROWSER_SESSION_SLOT_COUNT=10
BROWSER_SESSION_VIEWPORT=1440,900
EXECUTION_PREFLIGHT_ENABLED=true
EXECUTION_PREFLIGHT_DEBUG_PORT=19350
EXECUTION_PREFLIGHT_TIMEOUT_SECONDS=45
# Optional: chỉ cần khi lịch/report job phải gửi tóm tắt Telegram.
TELEGRAM_BOT_TOKEN=
