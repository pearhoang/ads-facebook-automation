APP_ENV=production
DATABASE_URL=postgresql+psycopg://meta_ads_owner:replace-me@127.0.0.1:55432/meta_ads_copilot
WORKER_SHARED_SECRET=replace-me
APP_ORIGIN=https://ads.lushmedia.net
HERMES_DASHBOARD_URL=https://hermes.ads.lushmedia.net
SECRET_ENCRYPTION_KEY=generate-a-fernet-key
WORKER_BOOTSTRAP_REPO_URL=https://github.com/pearhoang/ads-facebook-automation.git
WORKER_BOOTSTRAP_REPO_BRANCH=main
WORKER_ENROLLMENT_TTL_MINUTES=120
SESSION_COOKIE_NAME=ads_lush_session
CSRF_COOKIE_NAME=ads_lush_csrf
SESSION_TTL_HOURS=168
SESSION_COOKIE_SECURE=true
EXECUTION_ARTIFACT_ROOT=/opt/meta-ads-copilot-runtime/execution-artifacts
EXECUTION_ARTIFACT_MAX_BYTES=5242880
CREATIVE_ASSET_ROOT=/opt/meta-ads-copilot-runtime/creative-assets
CREATIVE_ASSET_MAX_BYTES=262144000
BROWSER_SESSION_TTL_MINUTES=120
BROWSER_PROXY_PORT_MIN=16080
BROWSER_PROXY_PORT_MAX=16179
