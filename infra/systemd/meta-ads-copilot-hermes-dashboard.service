[Unit]
Description=Ads Lush Hermes Native Dashboard
After=network-online.target meta-ads-copilot-hermes.service
Wants=network-online.target
ConditionPathExists=/opt/meta-ads-copilot-runtime/worker-data/hermes/config.yaml
ConditionPathExists=/etc/meta-ads-copilot/hermes-dashboard.env
ConditionPathExists=/usr/local/lib/hermes-agent/hermes_cli/web_dist/index.html

[Service]
Type=simple
Environment=HERMES_HOME=/opt/meta-ads-copilot-runtime/worker-data/hermes
Environment=HERMES_DASHBOARD_BIND_HOST=127.0.0.1
EnvironmentFile=-/etc/meta-ads-copilot/worker.env
EnvironmentFile=-/opt/meta-ads-copilot-runtime/worker-data/hermes/.env
EnvironmentFile=/etc/meta-ads-copilot/hermes-dashboard.env
ExecStart=/bin/sh -c 'exec /usr/local/bin/hermes dashboard --host "${HERMES_DASHBOARD_BIND_HOST:-127.0.0.1}" --port 9119 --skip-build --no-open'
Restart=on-failure
RestartSec=8
TimeoutStopSec=30
User=root

[Install]
WantedBy=multi-user.target
